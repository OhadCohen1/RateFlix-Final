                  "  pm.expect(json.data.totals).to.have.keys(['users', 'movies', 'ratings', 'favorites', 'categories']);",
                  "  pm.expect(json.data.engine).to.have.keys(['runs', 'avgMs', 'maxMs', 'knnRuns']);",
                  "});",
                  "pm.test('NFR-01: avg engine time under 1000ms', () => pm.expect(json.data.engine.avgMs).to.be.below(1000));"
                ]
              }
            }
          ],
